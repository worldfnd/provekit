 import Foundation
+import Darwin
+import Dispatch
 
 private let defaultFunction = "{{DEFAULT_FUNCTION}}"
 private let defaultIterations: UInt32 = 20
 private let defaultWarmup: UInt32 = 3
 
+private struct ProcessResourceSnapshot {
+    let cpuTotalMs: UInt64
+    let currentMemoryKb: UInt64
+}
+
+private struct ProcessResourceUsage {
+    let elapsedCpuMs: UInt64?
+    let peakMemoryKb: UInt64?
+}
+
+private func captureProcessResourceSnapshot() -> ProcessResourceSnapshot? {
+    var usage = rusage()
+    guard getrusage(RUSAGE_SELF, &usage) == 0 else {
+        return nil
+    }
+
+    let userMs = UInt64(usage.ru_utime.tv_sec) * 1000 + UInt64(usage.ru_utime.tv_usec) / 1000
+    let systemMs = UInt64(usage.ru_stime.tv_sec) * 1000 + UInt64(usage.ru_stime.tv_usec) / 1000
+
+    var info = task_vm_info_data_t()
+    var count = mach_msg_type_number_t(
+        MemoryLayout.size(ofValue: info) / MemoryLayout<natural_t>.size
+    )
+    let kerr = withUnsafeMutablePointer(to: &info) {
+        $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+            task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+        }
+    }
+
+    let memoryBytes: UInt64
+    if kerr == KERN_SUCCESS {
+        memoryBytes =
+            info.phys_footprint > 0 ? UInt64(info.phys_footprint) : UInt64(info.resident_size)
+    } else {
+        memoryBytes = 0
+    }
+
+    return ProcessResourceSnapshot(
+        cpuTotalMs: userMs + systemMs,
+        currentMemoryKb: memoryBytes / 1024
+    )
+}
+
+private final class ProcessResourceSampler {
+    private let queue = DispatchQueue(label: "dev.world.mobench.resource-sampler", qos: .utility)
+    private let lock = NSLock()
+    private var peakMemoryKb: UInt64 = 0
+    private var timer: DispatchSourceTimer?
+
+    func start() -> ProcessResourceSnapshot? {
+        let start = captureProcessResourceSnapshot()
+        peakMemoryKb = start?.currentMemoryKb ?? 0
+
+        let timer = DispatchSource.makeTimerSource(queue: queue)
+        timer.schedule(deadline: .now(), repeating: .milliseconds(20))
+        timer.setEventHandler { [weak self] in
+            guard let self else { return }
+            guard let snapshot = captureProcessResourceSnapshot() else { return }
+
+            self.lock.lock()
+            if snapshot.currentMemoryKb > self.peakMemoryKb {
+                self.peakMemoryKb = snapshot.currentMemoryKb
+            }
+            self.lock.unlock()
+        }
+        self.timer = timer
+        timer.resume()
+
+        return start
+    }
+
+    func stop(start: ProcessResourceSnapshot?) -> ProcessResourceUsage {
+        timer?.cancel()
+        timer = nil
+
+        let end = captureProcessResourceSnapshot()
+        let endingMemoryKb = end?.currentMemoryKb ?? 0
+
+        lock.lock()
+        if endingMemoryKb > peakMemoryKb {
+            peakMemoryKb = endingMemoryKb
+        }
+        let peak = peakMemoryKb
+        lock.unlock()
+
+        let elapsedCpuMs: UInt64?
+        if let start, let end {
+            elapsedCpuMs =
+                end.cpuTotalMs >= start.cpuTotalMs
+                ? end.cpuTotalMs - start.cpuTotalMs
+                : end.cpuTotalMs
+        } else {
+            elapsedCpuMs = nil
+        }
+
+        return ProcessResourceUsage(
+            elapsedCpuMs: elapsedCpuMs,
+            peakMemoryKb: peak > 0 ? peak : nil
+        )
+    }
+}
