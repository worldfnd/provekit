{
  "name": "provekit-wasm-demo",
  "version": "1.0.0",
  "description": "ProveKit WASM browser demo",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/install-packed-sdk.mjs && npm run build && playwright test",
    "demo:web": "npm run build && node scripts/serve.mjs",
    "serve": "npm run build && node scripts/serve.mjs",
    "clean": "rm -rf dist artifacts vendor pkg pkg-web"
  },
  "dependencies": {
    "provekit-sdk": "file:../../tooling/provekit-js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "jsdom": "^27.0.1",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
