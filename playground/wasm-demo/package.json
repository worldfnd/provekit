{
  "name": "provekit-wasm-demo",
  "version": "1.0.0",
  "description": "ProveKit WASM browser demo",
  "type": "module",
  "scripts": {
    "setup": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun scripts/setup.mjs",
    "wasm:build": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun scripts/build-provekit-wasm.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests vitest.config.ts",
    "test": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun --bun vitest run",
    "demo:web": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun run wasm:build && bun run build && bun scripts/serve.mjs",
    "serve": "export PATH=\"$HOME/.bun/bin:$PATH\"; bun run wasm:build && bun run build && bun scripts/serve.mjs",
    "clean": "rm -rf dist artifacts vendor pkg pkg-web pkg-local"
  },
  "dependencies": {
    "@atheonxyz/verity": "0.3.2-alpha",
    "@noir-lang/acvm_js": "1.0.0-beta.19",
    "@noir-lang/noir_js": "1.0.0-beta.19",
    "@noir-lang/noirc_abi": "1.0.0-beta.19",
    "@noir-lang/types": "1.0.0-beta.19",
    "@provekit-v1/acvm_js": "npm:@noir-lang/acvm_js@1.0.0-beta.11",
    "@provekit-v1/noir_js": "npm:@noir-lang/noir_js@1.0.0-beta.11",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "jsdom": "^27.0.1",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
