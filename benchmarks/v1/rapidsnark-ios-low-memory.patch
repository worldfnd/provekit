+static int
+groth16_prover_mapped_zkey(
+    const void          *zkey_buffer,
+    unsigned long long   zkey_size,
+    const void          *wtns_buffer,
+    unsigned long long   wtns_size,
+    char                *proof_buffer,
+    unsigned long long  *proof_size,
+    char                *public_buffer,
+    unsigned long long  *public_size,
+    char                *error_msg,
+    unsigned long long   error_msg_maxsize)
+{
+    void *prover = NULL;
+
+    try {
+        prover = new Groth16Prover(zkey_buffer, zkey_size, true);
+    } catch (std::exception& e) {
+        CopyError(error_msg, error_msg_maxsize, e);
+        return PROVER_ERROR;
+    }
+
+    int error = groth16_prover_prove(
+                    prover,
+                    wtns_buffer,
+                    wtns_size,
+                    proof_buffer,
+                    proof_size,
+                    public_buffer,
+                    public_size,
+                    error_msg,
+                    error_msg_maxsize);
+
+    groth16_prover_destroy(prover);
+    return error;
+}
